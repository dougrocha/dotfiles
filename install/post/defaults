#!/bin/bash

set -euo pipefail

missing=()

set_default() {
    local handler="$1"
    shift

    local found="" dir
    for dir in "$HOME/.local/share" ${XDG_DATA_DIRS//:/ }; do
        if [ -f "$dir/applications/$handler" ]; then
            found="yes"
            break
        fi
    done

    if [ -z "$found" ]; then
        missing+=("$handler")
        return 0
    fi

    local mime
    for mime in "$@"; do
        xdg-mime default "$handler" "$mime"
    done
}

: "${XDG_DATA_DIRS:=/usr/local/share:/usr/share}"

# Browser defaults
xdg-settings set default-web-browser chromium.desktop
set_default chromium.desktop \
    text/html \
    x-scheme-handler/http \
    x-scheme-handler/https \
    x-scheme-handler/about \
    x-scheme-handler/unknown \
    x-scheme-handler/mailto

# PDF defaults
set_default chromium.desktop \
    application/pdf \
    application/x-pdf

# Office document defaults (LibreOffice)
set_default libreoffice-writer.desktop \
    application/msword \
    application/vnd.openxmlformats-officedocument.wordprocessingml.document
set_default libreoffice-calc.desktop \
    application/vnd.ms-excel \
    application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
set_default libreoffice-impress.desktop \
    application/vnd.ms-powerpoint \
    application/vnd.openxmlformats-officedocument.presentationml.presentation
set_default libreoffice-draw.desktop \
    application/postscript

# File manager defaults
set_default org.gnome.Nautilus.desktop inode/directory

# Terminal defaults
set_default com.mitchellh.ghostty.desktop x-scheme-handler/terminal

# Video player defaults (mpv)
set_default mpv.desktop \
    video/mp4 \
    video/x-msvideo \
    video/x-matroska \
    video/x-flv \
    video/x-ms-wmv \
    video/mpeg \
    video/ogg \
    video/webm \
    video/quicktime \
    video/3gpp \
    video/3gpp2 \
    video/x-ms-asf \
    video/x-ogm+ogg \
    video/x-theora+ogg \
    application/ogg

# Text editor defaults (nvim)
set_default nvim.desktop \
    text/plain \
    text/english \
    text/x-makefile \
    text/x-c++hdr \
    text/x-c++src \
    text/x-chdr \
    text/x-csrc \
    text/x-java \
    text/x-moc \
    text/x-pascal \
    text/x-tcl \
    text/x-tex \
    application/x-shellscript \
    text/x-c \
    text/x-c++ \
    application/xml \
    text/xml

# Image viewer defaults (imv-dir)
set_default imv-dir.desktop \
    image/png \
    image/jpeg \
    image/gif \
    image/webp \
    image/bmp \
    image/tiff \
    image/svg+xml \
    image/avif \
    image/heif \
    image/jxl

# Application URL scheme handlers
set_default vesktop.desktop x-scheme-handler/discord
set_default cider.desktop \
    x-scheme-handler/cider \
    x-scheme-handler/itms \
    x-scheme-handler/itmss \
    x-scheme-handler/music \
    x-scheme-handler/itunes
set_default claude-code-url-handler.desktop x-scheme-handler/claude-cli
set_default com.anthropic.Claude.desktop x-scheme-handler/claude

if [ ${#missing[@]} -gt 0 ]; then
    echo "  ! skipped (desktop entry not installed): ${missing[*]}"
fi

echo "✓ Default applications set"

# vim: ft=sh
