#!/bin/bash

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DOTFILES_DIR

if ! command -v odin >/dev/null 2>&1; then
    echo "link: needs the odin compiler, run ./install/tools/odin.sh" >&2
    exit 1
fi

# odin run deletes the binary only when the linker exits 0, so build it in the cache dir rather than the current one.
out="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/linker"
mkdir -p "${out%/*}"
exec odin run "$DOTFILES_DIR/install/linker" -out:"$out" -- "$@"

# vim: ft=sh
