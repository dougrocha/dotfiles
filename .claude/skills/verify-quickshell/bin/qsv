#!/bin/bash
# Drive and observe the running quickshell session with real input. Run `qsv help`.
set -uo pipefail

export YDOTOOL_SOCKET="${YDOTOOL_SOCKET:-/tmp/.ydotool_socket}"
CAPTURE_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
EVIDENCE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/verify-quickshell"
RUN_FILE="$EVIDENCE_ROOT/.current-run"

declare -A KEYCODE=(
  [super]=125 [ctrl]=29 [shift]=42 [alt]=56 [esc]=1 [enter]=28 [tab]=15 [space]=57
  [a]=30 [b]=48 [c]=46 [d]=32 [e]=18 [f]=33 [g]=34 [h]=35 [i]=23 [j]=36 [k]=37 [l]=38 [m]=50
  [n]=49 [o]=24 [p]=25 [q]=16 [r]=19 [s]=31 [t]=20 [u]=22 [v]=47 [w]=17 [x]=45 [y]=21 [z]=44
)

die() { echo "qsv: $*" >&2; exit 1; }

yd() {
  ydotool "$@" >/dev/null 2>&1 || die "ydotool $1 failed; ydotoold is not accepting input, run: qsv doctor"
}

run_dir() {
  [[ -f $RUN_FILE ]] || die "no run started; run: qsv start <name>"
  cat "$RUN_FILE"
}

cmd_help() {
  cat <<'EOF'
qsv start <name>             new evidence dir under ~/.cache/verify-quickshell, prints its path
qsv doctor                   read-only health check of quickshell, Hyprland and input tools
qsv log                      log lines since the last quickshell reload, noise removed
qsv key <k1+k2+...>          press a chord through ydotool, e.g. super+ctrl+s, esc, enter
qsv at <x> <y>               put the pointer at global x,y and send one motion event
qsv click [x y]              left click, optionally after qsv at
qsv drag <x1> <y1> <x2> <y2> press, move in 5 steps, release
qsv shot <name> [geometry]   grim into the run dir, geometry like "0,0 2560x1440"
qsv layers [prefix]          mapped layer namespaces, optionally filtered by prefix
qsv pixel <png> <x> <y>      color of one pixel
qsv edge-count <png> <color> pixels within 6% of color on the outer 2px frame
qsv mark                     remember the newest file in ~/Pictures/Screenshots
qsv captured <name>          copy captures newer than the mark into the run dir, print size
qsv reset                    hide overlay and panels, release held keys and buttons
qsv cleanup                  reset, then delete the captures this run copied as evidence
EOF
}

cmd_start() {
  local dir
  dir="$EVIDENCE_ROOT/${1:?name}-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$dir" && echo "$dir" >"$RUN_FILE" && echo "$dir"
}

# shellcheck disable=SC2016 # each check string is evaluated later on purpose
cmd_doctor() {
  local ok=true
  check() { if eval "$2" >/dev/null 2>&1; then echo "ok    $1"; else echo "FAIL  $1  ($3)"; ok=false; fi; }
  check "one quickshell instance" '[[ $(( $(pgrep -xc qs) + $(pgrep -xc quickshell) )) -eq 1 ]]' "never start a second one"
  check "quickshell answers IPC" 'qs ipc show | grep -q "target screenshot-overlay"' "wait 1s after a reload"
  check "last reload clean" '[[ -z $(cmd_log) ]]' "run: qsv log"
  check "Hyprland answers" 'hyprctl monitors -j | jq -e "length > 0"' "not in a Hyprland session"
  check "ydotoold accepts input" 'ydotool mousemove -x 0 -y 0' "sudo rm -f $YDOTOOL_SOCKET; sudo -b ydotoold --socket-path=$YDOTOOL_SOCKET --socket-own=$(id -u):$(id -g)"
  check "grim, magick, jq, wtype installed" 'command -v grim && command -v magick && command -v jq && command -v wtype' "pacman -S grim imagemagick jq wtype"
  hyprctl monitors -j | jq -r '.[] | "info  monitor \(.name) at \(.x),\(.y) \(.width)x\(.height) scale \(.scale) special=\(.specialWorkspace.name)"'
  echo "info  cursor $(hyprctl cursorpos)"
  $ok
}

cmd_log() {
  qs log 2>&1 | tac | awk '{print} /Reloading configuration/{exit}' | tac |
    grep -v -E 'Reloading configuration|Configuration Loaded|polkit|qt.qpa.services|qt.text.font.db|Could not load icon|quickshell.dbus.properties|QDBusError'
}

cmd_key() {
  local -a down=() up=() names
  IFS=+ read -ra names <<<"${1:?chord}"
  for name in "${names[@]}"; do
    local code=${KEYCODE[${name,,}]:-}
    [[ -n $code ]] || die "unknown key: $name"
    down+=("$code:1")
    up=("$code:0" "${up[@]}")
  done
  yd key "${down[@]}" "${up[@]}"
}

cmd_at() {
  hyprctl dispatch "hl.dsp.cursor.move({ x = ${1:?x}, y = ${2:?y} })" >/dev/null
  yd mousemove -x 1 -y 0
  sleep 0.15
}

cmd_click() {
  [[ $# -eq 2 ]] && cmd_at "$1" "$2"
  yd click 0xC0
}

cmd_drag() {
  local x1=${1:?} y1=${2:?} x2=${3:?} y2=${4:?} i
  cmd_at "$x1" "$y1"
  yd click 0x40
  for i in 1 2 3 4 5; do cmd_at $((x1 + i * (x2 - x1) / 5)) $((y1 + i * (y2 - y1) / 5)); done
  yd click 0x80
}

cmd_shot() {
  local out
  out="$(run_dir)/${1:?name}.png"
  if [[ -n ${2:-} ]]; then grim -g "$2" "$out"; else grim "$out"; fi && echo "$out"
}

cmd_layers() {
  hyprctl layers -j | jq -r --arg p "${1:-}" '.. | objects | select(has("namespace")) | .namespace | select(startswith($p))' | sort
}

cmd_pixel() { magick "${1:?png}" -format "%[pixel:p{${2:?x},${3:?y}}]\n" info:; }

cmd_edge_count() {
  local png=${1:?png} color=${2:?color} w h total=0 crop
  read -r w h < <(magick "$png" -format '%w %h' info:)
  for crop in "${w}x2+0+0" "${w}x2+0+$((h - 2))" "2x${h}+0+0" "2x${h}+$((w - 2))+0"; do
    total=$((total + $(magick "$png" -crop "$crop" +repage -fuzz 6% -fill white -opaque "$color" -fill black +opaque white -format '%[fx:round(mean*w*h)]' info:)))
  done
  echo "$total"
}

cmd_mark() { touch "$(run_dir)/.mark"; }

cmd_captured() {
  local dir f n=0
  dir=$(run_dir)
  [[ -f $dir/.mark ]] || die "no mark; run: qsv mark before the capture"
  while IFS= read -r f; do
    n=$((n + 1))
    local i=1
    while [[ -e $dir/${1:?name}-$i.png ]]; do i=$((i + 1)); done
    cp "$f" "$dir/$1-$i.png"
    echo "$f" >>"$dir/.captures"
    echo "$dir/$1-$i.png $(magick "$f" -format '%wx%h' info:)"
  done < <(find "$CAPTURE_DIR" -maxdepth 1 -name '*.png' -newer "$dir/.mark" | sort)
  [[ $n -gt 0 ]] || { echo "none"; return 1; }
  cmd_mark
}

cmd_reset() {
  qs ipc call screenshot-overlay hide >/dev/null 2>&1
  for panel in notification-center settings-panel sound-panel bluetooth-panel music-panel; do
    qs ipc call "$panel" hide >/dev/null 2>&1
  done
  yd key 125:0 29:0 42:0 56:0
  yd click 0x80
  sleep 0.3
}

cmd_cleanup() {
  cmd_reset
  local dir
  dir=$(run_dir)
  if [[ -f $dir/.captures ]]; then
    sort -u "$dir/.captures" | xargs -r rm -f
    echo "deleted $(sort -u "$dir/.captures" | wc -l) test captures from $CAPTURE_DIR, evidence kept in $dir"
    rm -f "$dir/.captures"
  fi
}

sub=${1:-help}
shift || true
case "$sub" in
  help | -h | --help) cmd_help ;;
  start | doctor | log | key | at | click | drag | shot | layers | pixel | mark | captured | reset | cleanup) "cmd_$sub" "$@" ;;
  edge-count) cmd_edge_count "$@" ;;
  *) die "unknown command: $sub (run qsv help)" ;;
esac
