# EditorConfig for Linux configuration repository
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Same as home/.config/nvim/stylua.toml (StyLua defaults).
[*.lua]
indent_size = 4
max_line_length = 120

[*.{json,jsonc,yaml,yml}]
indent_size = 2
