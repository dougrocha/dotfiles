#!/usr/bin/python3
import colorsys
import json
import re
import sys
from pathlib import Path

HOME = Path.home()
SEED = HOME / ".cache/matugen/seed.json"
QUICKSHELL = HOME / ".config/quickshell/palette.json"
WALKER = HOME / ".config/walker/themes/default/colors.css"

SURFACE_SATURATION = 0.16
TEXT_SATURATION = 0.10
ACCENT_LIGHTNESS = (0.60, 0.78)

NEUTRALS = {
    "bg": (0.085, SURFACE_SATURATION),
    "surface": (0.125, SURFACE_SATURATION),
    "raised": (0.165, SURFACE_SATURATION),
    "overlay": (0.205, SURFACE_SATURATION),
    "text": (0.92, TEXT_SATURATION),
    "subtext": (0.70, TEXT_SATURATION),
    "muted": (0.50, TEXT_SATURATION),
}

WALKER_VARS = {
    "background": "surface",
    "text": "text",
    "primary": "accent",
    "border": "muted",
    "surface_container": "raised",
    "surface_container_high": "overlay",
}


def parse(hex_color):
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", hex_color):
        sys.exit(f"ramp: expected #RRGGBB, got {hex_color!r}")
    r, g, b = (int(hex_color[i : i + 2], 16) / 255 for i in (1, 3, 5))
    return colorsys.rgb_to_hls(r, g, b)


def to_hex(hue, lightness, saturation):
    rgb = colorsys.hls_to_rgb(hue, lightness, saturation)
    return "#" + "".join(f"{round(c * 255):02x}" for c in rgb)


def build(accent, accent_text):
    hue, lightness, saturation = parse(accent)
    chromatic = saturation > 0
    palette = {
        name: to_hex(hue, level, sat if chromatic else 0)
        for name, (level, sat) in NEUTRALS.items()
    }
    low, high = ACCENT_LIGHTNESS
    palette["accent"] = to_hex(hue, max(low, min(high, lightness)), saturation)
    palette["accentText"] = accent_text.lower()
    return palette


def walker_css(palette):
    lines = [
        f"@define-color {name} {palette[source]};"
        for name, source in WALKER_VARS.items()
    ]
    return (
        "/* Generated by ~/.config/matugen/ramp. Do not edit. */\n\n"
        + "\n".join(lines)
        + "\n"
    )


def main():
    seed = json.loads(SEED.read_text())
    palette = build(seed["accent"], seed["accentText"])
    parse(palette["accentText"])
    QUICKSHELL.write_text(json.dumps(palette, indent=2) + "\n")
    WALKER.write_text(walker_css(palette))


if __name__ == "__main__":
    main()
