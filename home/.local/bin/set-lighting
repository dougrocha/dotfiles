#!/usr/bin/env bash
# set-lighting [on|off]
#
# Switches the case lighting between two profiles and remembers the choice
# for boot:
#   on   OpenRGB on profile, Kraken LCD shows the current image
#   off  OpenRGB off profile, Kraken LCD backlight at 0
# Profile names live in default/systemd/openrgb/profiles.sh.
# With no argument, re-applies the remembered profile.
#
# The choice is saved before applying, since the apply scripts read it. If
# applying fails, the previous choice is restored and re-applied, so boot
# never replays a state that didn't work.

set -euo pipefail

# ~/.local/bin links here from the repo, so fall back to the link's target.
dotfiles_dir="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)}"
systemd_dir="$dotfiles_dir/default/systemd"
state_dir="$HOME/.local/state/lighting"
state_file="$state_dir/current"

mkdir -p "$state_dir"

# Serialize runs so an overlapping on/off can't leave RGB and LCD disagreeing.
exec 9>"$state_dir/lock"
flock 9
export LIGHTING_LOCKED=1

# Write then rename, so a reader never sees an empty file.
save_state() {
    printf '%s\n' "$1" >"$state_file.tmp"
    mv -f "$state_file.tmp" "$state_file"
}

apply() {
    local status=0
    "$systemd_dir/openrgb/apply-profile.sh" || status=1
    "$systemd_dir/kraken/apply-current-image.sh" || status=1
    return "$status"
}

previous=""
[[ -f "$state_file" ]] && previous="$(<"$state_file")"

case "${1:-}" in
    on|off) save_state "$1" ;;
    "") ;;
    *)
        echo "Usage: set-lighting [on|off]" >&2
        exit 1
        ;;
esac

status=0
if ! apply; then
    status=1
    if [[ -n "${1:-}" && "$1" != "${previous:-on}" ]]; then
        echo "Error: could not switch lighting $1, restoring ${previous:-on}" >&2
        if [[ -n "$previous" ]]; then
            save_state "$previous"
        else
            rm -f "$state_file"
        fi
        apply || true
    fi
fi

echo "Lighting: $(cat "$state_file" 2>/dev/null || echo on)"
exit "$status"
