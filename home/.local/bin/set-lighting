#!/usr/bin/env bash
# set-lighting [on|off]
#
# Switches the case lighting between two profiles and remembers the choice
# for boot. With no argument, re-applies the remembered profile.
# The choice is saved before applying, since the apply scripts read it. If
# applying fails, the previous choice is restored and re-applied.

set -euo pipefail

# ~/.local/bin links here from the repo, so fall back to the link's target.
dotfiles_dir="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)}"
systemd_dir="$dotfiles_dir/default/systemd"
# shellcheck source=SCRIPTDIR/../../../default/lighting/lighting.sh
source "$dotfiles_dir/default/lighting/lighting.sh"

mkdir -p "$lighting_state_dir"
lighting_lock

# Write then rename, so a reader never sees an empty file.
save_state() {
    printf '%s\n' "$1" >"$lighting_state_file.tmp"
    mv -f "$lighting_state_file.tmp" "$lighting_state_file"
}

apply() {
    local status=0
    "$systemd_dir/openrgb/apply-profile.sh" || status=1
    "$systemd_dir/kraken/apply-current-image.sh" || status=1
    return "$status"
}

previous=""
[[ -f "$lighting_state_file" ]] && previous="$(<"$lighting_state_file")"

case "${1:-}" in
    on|off) save_state "$1" ;;
    "") ;;
    *)
        echo "Usage: set-lighting [on|off]" >&2
        exit 1
        ;;
esac

status=0
if ! apply; then
    status=1
    if [[ -n "${1:-}" && "$1" != "${previous:-on}" ]]; then
        echo "Error: could not switch lighting $1, restoring ${previous:-on}" >&2
        if [[ -n "$previous" ]]; then
            save_state "$previous"
        else
            rm -f "$lighting_state_file"
        fi
        apply || true
    fi
fi

echo "Lighting: $(cat "$lighting_state_file" 2>/dev/null || echo on)"
exit "$status"
