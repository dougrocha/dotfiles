#!/usr/bin/env bash
# set-wallpaper <image> [--system-theme dark|light]
# matugen regenerates every template in ~/.config/matugen/config.toml (incl. the
# Base16 palette.json quickshell watches) and the GTK color-scheme; then hyprpaper.

set -euo pipefail

image=""
mode="dark"
while (($#)); do
    case "$1" in
        --system-theme) mode="${2:-}"; shift 2 ;;
        -*) echo "Unknown option: $1" >&2; exit 1 ;;
        *) image="$1"; shift ;;
    esac
done

[[ -n "$image" ]] || { echo "Usage: set-wallpaper <image> [--system-theme dark|light]" >&2; exit 1; }
[[ "$mode" == dark || "$mode" == light ]] || { echo "Error: --system-theme must be 'dark' or 'light'" >&2; exit 1; }
image="$(realpath "$image")"
[[ -f "$image" ]] || { echo "Error: file not found: $image" >&2; exit 1; }

matugen image -m "$mode" --source-color-index 0 "$image"
gsettings set org.gnome.desktop.interface color-scheme "prefer-$mode" 2>/dev/null || true

pkill -x hyprpaper || true
sleep 0.1
uwsm-app -- hyprpaper &>/dev/null &
disown

echo "Wallpaper set: $image ($mode)"
