#!/bin/bash

# Focus the window with the given class, or launch the command when there is none.
# Some bindings use this to keep a single instance of an app open.

if (($# == 0)); then
  echo "Usage: launch-or-focus [window-class] [launch-command [args...]]"
  exit 1
fi

WINDOW_CLASS="$1"
shift
cmd=("$@")
((${#cmd[@]})) || cmd=(uwsm-app -- "$WINDOW_CLASS")
WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg c "$WINDOW_CLASS" 'first(.[] | select(.class == $c) | .address) // empty')

if [[ -n $WINDOW_ADDRESS ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = 'address:$WINDOW_ADDRESS' })"
else
  exec setsid "${cmd[@]}"
fi

# vim: ft=sh
