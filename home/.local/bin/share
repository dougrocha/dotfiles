#!/bin/bash

MODE=${1:-$(printf '%s\n' clipboard file folder | walker --dmenu)}

case $MODE in
clipboard)
  # LocalSend may hand the send to a running instance and exit before reading the file,
  # so keep it in the private runtime dir and clear old ones on a later share
  find "$XDG_RUNTIME_DIR" -maxdepth 1 -name "share-*.txt" -mmin +60 -delete
  FILE=$(mktemp -p "$XDG_RUNTIME_DIR" share-XXXXXX.txt)
  wl-paste --no-newline >"$FILE" || { rm -f "$FILE"; exit 1; }
  FILES=("$FILE")
  ;;
file)
  readarray -t FILES < <(zenity --file-selection --multiple --separator=$'\n' --title="Select Files to Share")
  ;;
folder)
  readarray -t FILES < <(zenity --file-selection --directory --title="Select Folder to Share")
  ;;
*)
  exit 0
  ;;
esac

[[ -n ${FILES[0]} ]] || exit 0

systemd-run --user --quiet --collect localsend --headless send "${FILES[@]}" || { [[ -n $FILE ]] && rm -f "$FILE"; exit 1; }

# vim: ft=sh
