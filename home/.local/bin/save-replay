#!/bin/bash

pkill -SIGUSR1 -f gpu-screen-recorder

# gpu-screen-recorder writes the file asynchronously after the signal
sleep 0.5

REPLAY_DIR="$(xdg-user-dir VIDEOS)/Replays"
mkdir -p "$REPLAY_DIR"

LATEST_REPLAY=$(latest-file "$REPLAY_DIR" "*.mp4")

if [[ -f "$LATEST_REPLAY" ]]; then
    echo -n "$LATEST_REPLAY" | wl-copy

    notify-send "Replay Saved" \
        "Last 60 seconds saved\n$(basename "$LATEST_REPLAY")" \
        -t 10000 \
        -i "$LATEST_REPLAY" \
        -a "GPU Screen Recorder"
fi

# vim: ft=sh
