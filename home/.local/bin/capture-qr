#!/bin/bash

if [[ $1 != --geometry ]]; then
  exec quickshell ipc call screenshot-overlay toggleQuickWith capture-qr
fi

for _ in {1..50}; do
  hyprctl layers -j | jq -e '[.. | .namespace? | strings | select(startswith("qs.screenshot_overlay"))] | length == 0' >/dev/null && break
  sleep 0.02
done

RESULT=$(grim -g "$2" - | zbarimg -q --raw -Sdisable -Sqrcode.enable - 2>/dev/null)

if [[ -z $RESULT ]]; then
  notify-send -u critical "QR" "No QR code found in selection"
  exit 1
fi

printf "%s" "$RESULT" | wl-copy --sensitive
notify-send "QR" "Copied QR code contents to clipboard"

# vim: ft=sh
