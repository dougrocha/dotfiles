#!/bin/bash

if [[ $1 != --geometry ]]; then
  exec screenshot-ui toggleQuickWith capture-qr
fi

wait-screenshot-overlay

# zbarimg ends the payload with a newline; keep any newlines that belong to the payload itself
RESULT=$(grim -g "$2" - | zbarimg -q --raw -Sdisable -Sqrcode.enable - 2>/dev/null; echo .)
RESULT=${RESULT%.}
RESULT=${RESULT%$'\n'}

if [[ -z $RESULT ]]; then
  notify-send -u critical "QR" "No QR code found in selection"
  exit 1
fi

printf "%s" "$RESULT" | wl-copy --sensitive
notify-send "QR" "Copied QR code contents to clipboard"

# vim: ft=sh
