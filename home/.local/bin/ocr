#!/bin/bash

if [[ $1 != --geometry ]]; then
  exec quickshell ipc call screenshot-overlay toggleQuickWith ocr
fi

TMPFILE=$(mktemp /tmp/ocr-XXXXXX.png)
trap 'rm -f "$TMPFILE"' EXIT

for _ in {1..50}; do
  hyprctl layers -j | jq -e '[.. | .namespace? | strings | select(startswith("qs.screenshot_overlay"))] | length == 0' >/dev/null && break
  sleep 0.02
done

grim -g "$2" "$TMPFILE" || exit 1

TEXT=$(ocrs "$TMPFILE" 2>/dev/null) || exit 1

[[ -z $TEXT ]] && exit 1

printf "%s" "$TEXT" | wl-copy

# vim: ft=sh
