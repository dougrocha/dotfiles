#!/bin/bash

if [[ $1 != --geometry ]]; then
  exec screenshot-ui toggleQuickWith ocr
fi

TMPFILE=$(mktemp /tmp/ocr-XXXXXX.png)
trap 'rm -f "$TMPFILE"' EXIT

wait-screenshot-overlay

grim -g "$2" "$TMPFILE" || exit 1

TEXT=$(ocrs "$TMPFILE" 2>/dev/null)

if [[ -z $TEXT ]]; then
  notify-send -u critical "OCR" "No text found in selection"
  exit 1
fi

printf "%s" "$TEXT" | wl-copy

# vim: ft=sh
