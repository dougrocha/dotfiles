#!/bin/bash

# Show Claude Code hook events as alerts in the Quickshell island
input=$(cat)
{ read -r event; read -r session; read -r project; } < <(jq -r '(.hook_event_name // ""), (.session_id // "session")[0:8], ((.cwd // "") | sub("/+$"; "") | split("/") | last // "")' <<<"$input")
id="claude-$session"

case "$event" in
Stop) qs ipc call island push "$id" sparkle "Claude finished in $project" 4 ;;
Notification) qs ipc call island push "$id" sparkle "Claude needs you in $project" 8 ;;
UserPromptSubmit) qs ipc call island clear "$id" ;;
esac >/dev/null 2>&1

exit 0
